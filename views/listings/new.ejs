<% layout("/layouts/boilerplate") %>
<div class="row mt-5">
  <div class="col-8 offset-2">
    <h3>Create a New listing</h3>
    <form
      method="POST"
      action="/listings"
      novalidate
      class="needs-validation mb-5"
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input
          name="listing[title]"
          placeholder="Add a title for your property"
          type="text"
          class="form-control"
          required
        />
        <div class="valid-feedback">Title looks good!</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea
          name="listing[description]"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">Please enter a short description</div>
      </div>

      <div class="mb-3">
        <label for="category" class="form-label">Category</label>
        <select name="listing[category]" id="category" class="form-select">
          <option value="">Automatically detect category</option>
          <option value="Trending">Trending</option>
          <option value="New">New</option>
          <option value="Rooms">Rooms</option>
          <option value="Iconic cities">Iconic cities</option>
          <option value="Beach Stays">Beach Stays</option>
          <option value="Mountains">Mountains</option>
          <option value="Castles">Castles</option>
          <option value="Amazing pools">Amazing pools</option>
          <option value="Camping">Camping</option>
          <option value="Farms">Farms</option>
          <option value="Arctic">Arctic</option>
          <option value="Domes">Domes</option>
          <option value="Temples">Temples</option>
          <option value="Cruises">Cruises</option>
          <option value="Restaurants">Restaurants</option>
          <option value="Cabins">Cabins</option>
        </select>
        <small class="text-muted">Leave this blank to detect a category from the title and description.</small>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Upload Listing Image </label>
        <input name="listing[image]" type="file" class="form-control" />
        required
      </div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Price</label>
          <input
            name="listing[price]"
            placeholder="e.g. 1200"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Price should be valid</div>
        </div>

        <div class="mb-3 col-md-8">
          <label for="country" class="form-label">Country</label>
          <input
            name="listing[country]"
            placeholder="e.g. India"
            type="text"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Country should be valid</div>
        </div>
      </div>

      <div class="mb-3">
        <label for="loaction" class="form-label">Location</label>
        <input
          name="listing[location]"
          placeholder="e.g. Nagpur, Maharashtra"
          type="text"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Location should be valid</div>
      </div>

      <button class="btn btn-dark add-btn mt-3">Add</button>
    </form>
  </div>
</div>
